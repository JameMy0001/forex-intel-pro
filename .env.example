# -------------------------------------------------------------
# Forex & Stock Intelligence Engine - Environment Variables
# -------------------------------------------------------------

# 1. Finnhub API (Real-time Prices & Stock News) - https://finnhub.io (Free 60 calls/min)
FINNHUB_API_KEY=your_finnhub_api_key_here

# 2. Marketaux API (Global News & Sentiment) - https://marketaux.com (Free ~100 calls/day)
MARKETAUX_API_KEY=your_marketaux_api_key_here

# 3. Google Gemini API (AI Deep Macro Synthesis & Trade Thesis) - https://aistudio.google.com (Free)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Turso Database (Distributed SQLite Cloud) - https://app.turso.tech/jame (Free 9GB)
# (If left blank, the app will automatically use local SQLite at data/intel.db)
TURSO_DATABASE_URL=libsql://your-db-jame.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 5. Telegram Bot Alerts - Created via @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 6. Cron Security Secret (for securing API cron trigger endpoints)
CRON_SECRET=your_custom_secure_cron_secret_123
